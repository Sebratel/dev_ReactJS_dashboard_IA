# ─────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do Indicadores Sebratel.
#
# Em DESENVOLVIMENTO: copie para `.env` e preencha (valores reais do .env do
# dev_ReacJS_HealthyScore-staging — mesmo banco/mesma conta OAuth).
#
# Em PRODUÇÃO (stack do Portainer apontada para o GitHub): não existe arquivo
# .env. Estas mesmas chaves vão no campo "Environment variables" da stack —
# ver DEPLOY-PORTAINER.md. As que o `web` precisa em runtime são geradas em
# /config.js no boot do container (docker/entrypoint.sh).
# ─────────────────────────────────────────────────────────────────────────

# ─── Google OAuth / SSO ──────────────────────────────────────────────────
# Client ID da aplicação Google. Em produção use GOOGLE_CLIENT_ID (é o nome
# que o docker-compose passa para os serviços `web` e `api`); em
# desenvolvimento o Vite lê VITE_GOOGLE_CLIENT_ID do .env. Os dois nomes
# funcionam nos dois lugares — ver src/lib/runtimeConfig.ts.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Client secret da mesma aplicação Google. Só é usado por um fluxo de
# autorização feito NO SERVIDOR (troca de `code` por token). O login atual é o
# fluxo implícito do Google Identity Services, feito no navegador, que não usa
# secret nenhum — então esta variável fica declarada e sem efeito até essa
# migração acontecer. Ver DEPLOY-PORTAINER.md, seção SSO.
GOOGLE_CLIENT_SECRET=

# Domínio permitido no login (qualquer conta fora dele recebe 403).
ALLOWED_DOMAIN=sebratel.com.br

# Administradores, separados por vírgula. Sem isto valem só os e-mails
# embutidos em server/accessLog.mjs.
ADMIN_EMAILS=

# ─── Cifra de segredos em disco ──────────────────────────────────────────
# Chave usada para cifrar os tokens do Data Hub guardados em
# data/lakehouseSources.json (AES-256-GCM, ver server/secretBox.mjs).
# Qualquer texto serve — é derivado para 32 bytes. Deixando vazio, uma chave
# aleatória é gerada em data/.secret-key na primeira vez e reusada.
#   IMPORTANTE: precisa ser a MESMA nos serviços `api` e `etl`.
#   Trocar a chave invalida os tokens já salvos (precisam ser recadastrados).
# Gerar uma: openssl rand -base64 32
SECRETS_KEY=

# ─── Data Hub / lakehouse (API pública de leitura) ───────────────────────
# Endereço sugerido no cadastro de uma fonte nova, na tela de Configurações.
# O dataset e o TOKEN de cada fonte não ficam aqui: são cadastrados pela tela,
# por quem for fazer a integração, e o token é guardado cifrado.
DHUB_BASE_URL=https://data-hub.sebratel.net.br
# Ajustes finos da busca (os padrões servem bem — mexa só se necessário).
DHUB_PAGE_SIZE=50000
DHUB_MAX_ROWS=500000
DHUB_TIMEOUT_MS=120000

# ─── Postgres — ERP Voalle (mesmo banco DB_ELLEVEN do HealthyScore) ──────
# Necessário nos serviços `api` (testar query no editor) E `etl` (rodar as
# queries do catálogo). Uma instalação que só use fontes do Data Hub pode
# deixar tudo vazio: as queries SQL falham individualmente e o resto funciona.
DB_ELLEVEN_HOST=
DB_ELLEVEN_PORT=5432
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_SSL=

# ─── MariaDB — DB_Applicattion (backlog/equipes) ─────────────────────────
DB_MARIA_HOST=
DB_MARIA_PORT=3306
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=

# ─── API / ETL ───────────────────────────────────────────────────────────
API_PORT=8788
SNAPSHOT_PATH=./public/installData.data
# Ciclo BASE do agendador do ETL, em minutos (scripts/etl-scheduler.mjs). Não
# é o ritmo de cada fonte: isso se configura por fonte na tela (tempo real /
# agendada). Ciclo curto é o que faz "tempo real" significar algo.
ETL_BASE_INTERVAL_MINUTES=2
# 'true' força uma execução do ETL assim que o container sobe.
ETL_RUN_ON_START=false

# ─── Porta publicada pela stack (só produção) ────────────────────────────
WEB_PORT=8081

# ─── Planilhas do Google no Builder ──────────────────────────────────────
# Reusam o MESMO Client ID acima e o próprio token OAuth do usuário logado —
# sem service account, sem variável nova. Só precisa, uma vez, no Google Cloud
# do projeto desse Client ID: (1) habilitar a "Google Sheets API"; (2) se a
# tela de consentimento OAuth for do tipo "Externo", adicionar o escopo
# ".../auth/spreadsheets.readonly" nela (tipo "Interno", restrito ao
# Workspace, não passa por revisão do Google). Usuários já logados antes dessa
# mudança precisam sair e entrar de novo pra conceder o escopo novo.
