# Copiar valores reais do .env do dev_ReacJS_HealthyScore-staging (mesmo banco/mesma conta OAuth).

# Postgres — ERP Voalle (mesmo banco DB_ELLEVEN do HealthyScore)
DB_ELLEVEN_HOST=
DB_ELLEVEN_PORT=5432
DB_ELLEVEN_DATABASE=
DB_ELLEVEN_USER=
DB_ELLEVEN_PASSWORD=
DB_ELLEVEN_SSL=

# MariaDB — DB_Applicattion (backlog/equipes), mesmo banco do HealthyScore
DB_MARIA_HOST=
DB_MARIA_PORT=3306
DB_MARIA_DATABASE=
DB_MARIA_USER=
DB_MARIA_PASSWORD=

# Google OAuth (login) — mesmo Client ID do HealthyScore
# Planilhas do Google no Builder (server/googleSheets.mjs) reusam este MESMO
# Client ID e o próprio token OAuth do usuário logado — sem service account,
# sem variável nova. Só precisa, uma vez, no Google Cloud do projeto deste
# Client ID: (1) habilitar a "Google Sheets API"; (2) se a tela de
# consentimento OAuth for do tipo "Externo", adicionar o escopo
# ".../auth/spreadsheets.readonly" nela (tipo "Interno", restrito ao
# Workspace, não passa por revisão do Google). Usuários já logados antes
# dessa mudança precisam sair e entrar de novo pra conceder o escopo novo.
VITE_GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=sebratel.com.br

# API / ETL
API_PORT=8788
SNAPSHOT_PATH=./public/installData.data
# Vazio/vinte e poucos minutos = quase em tempo real (ver scripts/etl-scheduler.mjs)
ETL_INTERVAL_MINUTES=15
