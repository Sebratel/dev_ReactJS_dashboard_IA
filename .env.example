# ─────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do Indicadores Sebratel.
#
# Em DESENVOLVIMENTO: copie para `.env` e preencha. Depois de editar o `.env`,
# reinicie a API — o `npm run api` recarrega ao salvar arquivo de server/, mas
# não observa o `.env` (ver a chave "//api" do package.json).
#
# Em PRODUÇÃO (stack do Portainer apontada para o GitHub): não existe arquivo
# .env. Estas mesmas chaves vão no campo "Environment variables" da stack —
# ver DEPLOY-PORTAINER.md. O serviço `web` não precisa de variável nenhuma: ele
# serve só a SPA estática, e todo segredo fica no `api`.
# ─────────────────────────────────────────────────────────────────────────

# ─── Google OAuth / SSO ──────────────────────────────────────────────────
# O login é o fluxo de CÓDIGO DE AUTORIZAÇÃO, conduzido pelo servidor: o
# navegador é redirecionado ao Google e volta com um `code`, que a API troca
# por tokens usando o secret. Por isso as duas variáveis abaixo são
# OBRIGATÓRIAS e ficam só no backend — o frontend não recebe nenhuma delas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço público da aplicação. É com ele que o `redirect_uri` é montado, e o
# Google exige que seja IDÊNTICO ao cadastrado no Google Cloud.
#   Desenvolvimento: http://localhost:5173
#   Produção:        http://<host-ou-ip>:8081  (ou o domínio interno)
# Deixando vazio, é derivado dos cabeçalhos da requisição — funciona atrás do
# nginx, mas declarar é mais previsível.
#
# No Google Cloud → Credenciais → seu Client ID OAuth, cadastre como "URI de
# redirecionamento autorizado" este valor + /api/auth/google/callback, ex.:
#   http://localhost:5173/api/auth/google/callback
#   http://<host-ou-ip>:8081/api/auth/google/callback
APP_BASE_URL=

# Tempo de vida da sessão de login, em dias.
SESSION_TTL_DAYS=30

# Domínio permitido no login (qualquer conta fora dele recebe 403).
ALLOWED_DOMAIN=sebratel.com.br

# Administradores, separados por vírgula. Sem isto valem só os e-mails
# embutidos em server/accessLog.mjs.
ADMIN_EMAILS=

# Bypass do login, SÓ pra desenvolvimento. Com AUTH_DISABLED=true a API para de
# exigir o cookie de sessão e atende toda requisição como AUTH_DISABLED_EMAIL —
# serve pra testar as telas num navegador de verdade sem passar pelo fluxo do
# Google (que precisa de navegação até o accounts.google.com e não funciona
# atrás de firewall). Permissão continua saindo do e-mail, então o que aparece
# é o que aquela pessoa veria logada. NUNCA em produção: com isso ligado,
# qualquer um que alcance a API é esse usuário. Vazio/ausente = SSO normal.
AUTH_DISABLED=
# E-mail assumido pelo bypass. Precisa ser do ALLOWED_DOMAIN — se não for, a API
# não sobe (e diz por quê). Padrão: misael.cruz@sebratel.com.br.
AUTH_DISABLED_EMAIL=

# ─── Montagem com IA — NÃO SE CONFIGURA AQUI ─────────────────────────────
#
# Desde 10/09/2026 a configuração de IA (provedor, credencial, modelo, esforço,
# teto de tokens, idas por turno, orçamento diário, preço e endpoint) é editada
# em "Configurações › Provedor de IA" e guardada em data/aiConfig.json, com a
# credencial cifrada — ver server/aiConfig.mjs.
#
# Nenhuma variável de ambiente de IA é lida pelo app. ANTHROPIC_API_KEY,
# AI_MODEL, AI_EFFORT, AI_MAX_TOKENS, AI_MAX_ITERATIONS e AI_DAILY_BUDGET_USD
# existiam aqui e foram removidas de propósito: semente é uma segunda fonte de
# verdade para a mesma decisão — dois lugares onde procurar "qual modelo está
# rodando", e um deles mentindo assim que alguém salva pela tela.
#
# Instalação nova sobe com a IA NÃO CONFIGURADA, e um administrador cadastra o
# provedor na tela (a lista de modelos vem da própria conta do provedor).
#
# As duas exceções, que são da leitura de gráfico e não da montagem, seguem
# valendo do ambiente porque nunca tiveram tela — os padrões servem bem:
# AI_INSIGHT_EFFORT (medium) e AI_INSIGHT_MAX_TOKENS (1200).

# ─── Cifra de segredos em disco ──────────────────────────────────────────
# Chave usada para cifrar, com AES-256-GCM (ver server/secretBox.mjs), os
# tokens do Data Hub (data/lakehouseSources.json) e os tokens do Google das
# sessões de login (data/sessions.json).
# Qualquer texto serve — é derivado para 32 bytes. Deixando vazio, uma chave
# aleatória é gerada em data/.secret-key na primeira vez e reusada.
#   IMPORTANTE: precisa ser a MESMA nos serviços `api` e `etl`.
#   Trocar a chave invalida os tokens do Data Hub já salvos (precisam ser
#   recadastrados) e desloga todos os usuários.
# Gerar uma: openssl rand -base64 32
SECRETS_KEY=

# ─── Data Hub / lakehouse (API pública de leitura) ───────────────────────
# Endereço sugerido no cadastro de uma fonte nova, na tela de Configurações.
# O dataset e o TOKEN de cada fonte não ficam aqui: são cadastrados pela tela,
# por quem for fazer a integração, e o token é guardado cifrado.
DHUB_BASE_URL=https://data-hub.sebratel.net.br
# Ajustes finos da busca. O padrão de página é 10.000 porque é o teto do
# próprio Data Hub: ele devolve no máximo isso por requisição, mesmo que se
# peça mais (e ecoa no corpo o limit pedido, não o aplicado).
DHUB_PAGE_SIZE=10000
DHUB_MAX_ROWS=500000
DHUB_TIMEOUT_MS=120000

# ─── Não existe credencial de banco aqui ─────────────────────────────────
# Este projeto NÃO fala com Postgres nem MariaDB. Todo dado corporativo entra
# pelo Data Hub (acima), que é o barramento. Havia antes um catálogo de queries
# SQL que batia direto no ERP e no MariaDB, com DB_ELLEVEN_* e DB_MARIA_*;
# manter os dois caminhos consumia duas plataformas grandes pela mesma
# informação, então o SQL foi removido. Se você precisa de um dado novo no
# dashboard, publique o dataset no Data Hub e cadastre a fonte na tela.

# ─── API / ETL ───────────────────────────────────────────────────────────
API_PORT=8788
SNAPSHOT_PATH=./public/installData.data
# Ciclo BASE do agendador do ETL, em minutos (scripts/etl-scheduler.mjs). Não
# é o ritmo de cada fonte: isso se configura por fonte na tela (tempo real /
# agendada). Ciclo curto é o que faz "tempo real" significar algo.
ETL_BASE_INTERVAL_MINUTES=2
# 'true' força uma execução do ETL assim que o container sobe.
ETL_RUN_ON_START=false

# ─── Porta publicada pela stack (só produção) ────────────────────────────
WEB_PORT=8081

# ─── Planilhas do Google no Builder ──────────────────────────────────────
# Reusam o MESMO Client ID acima e o próprio token OAuth do usuário logado —
# sem service account, sem variável nova. Só precisa, uma vez, no Google Cloud
# do projeto desse Client ID: (1) habilitar a "Google Sheets API"; (2) se a
# tela de consentimento OAuth for do tipo "Externo", adicionar o escopo
# ".../auth/spreadsheets.readonly" nela (tipo "Interno", restrito ao
# Workspace, não passa por revisão do Google). Usuários já logados antes dessa
# mudança precisam sair e entrar de novo pra conceder o escopo novo.
