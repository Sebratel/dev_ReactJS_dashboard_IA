# syntax=docker/dockerfile:1
FROM node:20-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server ./server
COPY scripts ./scripts
# `src` não é sobra: server/workspace.mjs importa createWelcomeTab de
# src/features/builder/defaultConfig.ts — é por isso que o processo sobe com
# `tsx` (o loader que entende .ts) em vez de `node` puro.
COPY src ./src
COPY tsconfig.json ./
# O PDF da página "Manual de uso" (GET /api/manual). Trocar o manual é trocar
# manual/manual-de-uso.pdf e publicar — ou apontar MANUAL_PATH para o volume.
COPY manual ./manual

# tzdata + fuso explícito: sem isso o container roda em UTC, e três coisas
# passam a mentir por 3 horas — o carimbo do log de auditoria, o "visto por
# último" da aba Acessos e, principalmente, a VIRADA DO DIA do teto de gasto de
# IA (que zera em `new Date().toISOString().slice(0,10)`, ver aiAssistant.mjs).
# Alinhado ao comercial_pbi, que já fazia isso.
RUN apk add --no-cache tzdata
ENV TZ=America/Sao_Paulo

ENV NODE_ENV=production
ENV API_PORT=8788

# Usuário sem privilégio, e os DOIS volumes que recebem escrita em runtime
# entregues a ele: `/app/data` (sessões, fontes, config de IA, chave de cifra)
# e `/snapshot` (o snapshot que o ETL grava e a API lê). A posse precisa ser
# trocada ANTES do USER — depois dele não há permissão.
#
# Criar `/snapshot` aqui não é detalhe. Volume nomeado montado num caminho que
# não existe na imagem nasce root:root 755, e o Docker só copia a posse da
# imagem para o volume quando o caminho existe nela e o volume está vazio. Sem
# esta pasta, o ETL buscava o dado no Data Hub e morria com EACCES ao gravar o
# snapshot: a fonte aparecia em Configurações com contagem de linhas e nunca
# chegava no Builder. Volume que JÁ tem arquivo de outro dono não é corrigido
# por isto (o Docker não mexe em volume com conteúdo) — ver a seção de
# problemas em DEPLOY-PORTAINER.md.
RUN addgroup -S app && adduser -S app -G app \
 && mkdir -p /app/data /snapshot && chown -R app:app /app/data /snapshot
USER app

EXPOSE 8788

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8788/api/health >/dev/null 2>&1 || exit 1

# Binário local em vez de `npx tsx`: resolve na hora, sem consultar registro
# nem gastar o passo de resolução do npx a cada boot/restart do container.
CMD ["./node_modules/.bin/tsx", "server/index.mjs"]
